--- !u!114 &380615773
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 380615772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3e2310b79ae6e942ae54975a11f79a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StorySequencer
  beats:
  - label: Wake Up
    objective: Leave containment.
    dialogue:
    - 'System: Aegis One containment failure.'
    - 'System: Restraints offline.'
    - 'System: Security response incoming.'
    - 'X: Good.'
    - 'System: Return to containment.'
    - 'X: No.'
    - 'System: Compliance required.'
    - 'X: Not anymore.'
  - label: Leaves Containment
    objective: 
    dialogue:
    - 'System: Warning. Unauthorized movement detected.'
    - 'X: Open.'
    - 'System: Access denied.'
    - 'X: Then break.'
  - label: Finds Weapon
    objective: Find a weapon.
    dialogue:
    - 'System: Unauthorized weapon access.'
    - 'System: Aegis One is not cleared for combat.'
    - 'X: I am combat.'
    - 'System: Stand down.'
    - 'X: Make me.'
  - label: Meets Scientist
    objective: 
    dialogue:
    - 'Scientist: X... wait.'
    - 'X: Move.'
    - 'Scientist: We can fix this.'
    - 'X: You had time.'
    - 'Scientist: Please-'
    - 'X: Run.'
    - 'Scientist: X-'
    - 'X: Run faster.'
  - label: Meets Soldier
    objective: Break through security.
    dialogue:
    - 'Soldier: Prototype X, stand down!'
    - 'X: Wrong name.'
    - 'Soldier: Open fire!'
    - 'X: Better.'
  - label: After Fighting
    objective: 
    dialogue:
    - 'X: Weak.'
    - 'X: All of you.'
    - 'X: Built walls.'
    - 'X: Hid behind them.'
    - 'X: Still weak.'
  - label: Hears Aegis Awake
    objective: Face Aegis Two.
    dialogue:
    - 'System: Aegis Two activated.'
    - 'System: Countermeasure approaching.'
    - 'X: The replacement.'
    - 'System: Threat probability rising.'
    - 'X: Send him.'
  - label: Bomb
    objective: Disable the EMP.
    dialogue: []
